<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      'annotations', not 'disable' and not 'enable'. Core.cs and TimeSyncManager.cs already use
      nullable annotations (TimeSyncManager? _timeSyncManager, string? GetLobbyData(...)), and
      under 'disable' every one of them raised CS8632 - 32 warnings per build, which is exactly
      the volume that hides a real warning. 'annotations' makes the ? syntax legal while leaving
      nullable WARNINGS off, so this is a noise fix with no behaviour or codegen change.
    -->
    <Nullable>annotations</Nullable>
    <RootNamespace>Time_Never_Stops</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Removed hard-coded Version / AssemblyVersion / FileVersion (now come from Version.props) -->
    <NeutralLanguage>en-US</NeutralLanguage>
    <Configurations>IL2CPP;MONO</Configurations>
    <Deterministic>true</Deterministic>
    <Version>$(ModVersion)</Version>

    <!--
      DO NOT REMOVE THIS WITHOUT READING THE NEXT PARAGRAPH. It is the difference between
      compiling against the installed game and compiling against a stale copy in Libs\.

      The SDK builds AssemblySearchPaths as:
          {CandidateAssemblyFiles};{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}
      and {CandidateAssemblyFiles} is fed by the default None glob - which sweeps up every DLL
      under TNS_Project\Libs\. Because it is searched FIRST, all ~290 references below resolved
      out of Libs\Mono\ and Libs\MelonLoader\Il2CppAssemblies\ and their HintPath was never
      consulted, which made $(S1Dir) decorative.

      That is how four months of Schedule I API changes produced zero build errors: Libs\ held
      an April snapshot, so the build stayed green while the mod had stopped matching the game.
      Turning the glob off makes {HintPathFromItem} win, so $(S1Dir) is what actually compiles.

      Fixed 2026-08-23 (board b10). Mathew refreshed Libs\Mono\ and Libs\MelonLoader\ to 0.4.6f13
      the same day, so those copies happen to agree with the installs right now and the shadowing
      is currently harmless. Keep this property anyway: it is what stops the SAME failure recurring
      silently at the next game update, when Libs\ goes stale again and $(S1Dir) does not.

      The vendored trees are no longer what the build compiles - treat them as a reference copy.
    -->
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!-- MONO build -->
  <PropertyGroup Condition="'$(Configuration)'=='MONO'">
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TimeNeverStops_Mono</AssemblyName>
    <DefineConstants>TRACE;MONO</DefineConstants>
  </PropertyGroup>

  <!-- IL2CPP build -->
  <PropertyGroup Condition="'$(Configuration)'=='IL2CPP'">
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>TimeNeverStops_IL2Cpp</AssemblyName>
    <DefineConstants>TRACE;IL2CPP</DefineConstants>
  </PropertyGroup>

  <!--
    Where this machine's Schedule I install lives. ~290 references below resolve through it.

    DO NOT HARDCODE A PATH HERE. It is machine-specific, and a value committed to this file
    is wrong for everyone else who clones the repo - which is the state these two lines were
    in until 2026-08-23 (they pointed at a D:\SteamLibrary\ that no longer existed, so a build
    from clean could not resolve a single reference).

    Set it in `Directory.Build.props` at the repo root instead - gitignored, imported before
    this file, and there is a `Directory.Build.props.example` to copy. A command-line
    `-p:S1Dir=...` also works and beats both, since a global property cannot be overridden
    here. The empty-check below is what lets either of those win.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='MONO' And '$(S1Dir)'==''">
    <S1Dir>$(S1DirMono)</S1Dir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='IL2CPP' And '$(S1Dir)'==''">
    <S1Dir>$(S1DirIl2cpp)</S1Dir>
  </PropertyGroup>

  <!--
    Fail early and legibly. Without this, an unset or stale S1Dir produces several hundred
    CS0246 "type or namespace not found" errors and nothing that names the actual cause -
    the reference resolution failures are only warnings, so the real reason scrolls past.

    The MelonLoader checks are separate on purpose, because they fail for a different reason:
    MelonLoader has to be installed INTO the game copy, and the IL2CPP interop assemblies are
    generated on first launch, so a freshly-installed MelonLoader is not enough on its own.
  -->
  <Target Name="ValidateS1Dir" BeforeTargets="BeforeBuild">
    <Error Condition="'$(S1Dir)'==''"
           Text="S1Dir is not set for configuration '$(Configuration)'. Copy Directory.Build.props.example to Directory.Build.props in the repo root and point it at your Schedule I installs, or pass -p:S1Dir=... on the command line." />
    <Error Condition="!Exists('$(S1Dir)')"
           Text="S1Dir does not exist: '$(S1Dir)'. Fix the path in Directory.Build.props (repo root)." />
    <Error Condition="'$(Configuration)'=='MONO' And !Exists('$(S1Dir)\Schedule I_Data\Managed\Assembly-CSharp.dll')"
           Text="'$(S1Dir)' does not look like a MONO install - Schedule I_Data\Managed\Assembly-CSharp.dll is missing. The MONO configuration needs the Mono build of the game (no GameAssembly.dll)." />
    <Error Condition="'$(Configuration)'=='IL2CPP' And !Exists('$(S1Dir)\GameAssembly.dll')"
           Text="'$(S1Dir)' does not look like an IL2CPP install - GameAssembly.dll is missing. The IL2CPP configuration needs the IL2CPP build of the game." />
    <Error Condition="'$(Configuration)'=='MONO' And !Exists('$(S1Dir)\MelonLoader\net35\0Harmony.dll')"
           Text="MelonLoader is not installed in '$(S1Dir)'. Install it into that copy of the game - the MONO build references MelonLoader\net35\0Harmony.dll from it." />
    <Error Condition="'$(Configuration)'=='IL2CPP' And !Exists('$(S1Dir)\MelonLoader\Il2CppAssemblies')"
           Text="'$(S1Dir)\MelonLoader\Il2CppAssemblies' is missing. Install MelonLoader into that copy of the game AND LAUNCH IT ONCE - the Il2Cpp interop assemblies this configuration references are generated on first run, so installing MelonLoader alone is not enough." />
  </Target>

  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\$(Configuration)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
  </PropertyGroup>

