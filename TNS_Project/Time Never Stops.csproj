	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Core.cs" />
		<Compile Include="TimeSyncManager.cs" />
		<!--
			EnableDefaultCompileItems is false above, so a new .cs file is NOT picked up
			automatically — it must be listed here or it silently will not compile.
		-->
		<Compile Include="DailySummaryStore.cs" />
		<Compile Include="S1APIBridge.cs" />
		<Compile Include="DailySummaryApp.cs" />
		<Compile Include="LocalMultiplayer.cs" />
		<Compile Include="TemplateUtils\AssetBundleUtils.cs" />
		<Folder Include="Libs\" />
		<!--Uncomment if with assetbundle-->
		<!--<EmbeddedResource Include="Assets\your.assetbundle" />-->
		<!--
			The phone-app icon, embedded rather than shipped loose.

			S1API's PhoneApp.IconFileName loads a PNG from MelonEnvironment.ModsDirectory, which
			would mean asking players to drop a file next to the DLL — and logging an Error on every
			single load if they did not. Embedding it makes the app self-contained: the DLL is the
			only thing that has to be installed, and there is no missing-file failure mode.
			Reused from the repo-root icon that already ships as the Thunderstore/Nexus package icon.
			Resource name: Time_Never_Stops.icon.png
		-->
		<EmbeddedResource Include="..\icon.png" LogicalName="Time_Never_Stops.icon.png" />
	</ItemGroup>

	<!--Packages-->
	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!--
			S1API — the community cross-compatibility layer. Used ONLY for the Daily Summary phone
			app (DailySummaryApp.cs); nothing in the time/sleep/sync path touches it.

			ONE reference serves BOTH arms on purpose. The package ships a single netstandard2.1
			assembly built against the Mono game refs, and net6.0 consumes netstandard2.1 fine. At
			runtime the S1APILoader plugin enables S1API.Mono.MelonLoader.dll or
			S1API.Il2Cpp.MelonLoader.dll to match the game; both carry assembly identity "S1API" and
			the same public surface, so our compile-time binding resolves either way. This is the
			pattern S1API itself documents and that k073l/s1-modsapp ships.

			ExcludeAssets=runtime is REQUIRED: players get S1API from its own Thunderstore/Nexus
			package (declared in packaging\*.toml). Without this, S1API.dll and Newtonsoft.Json.dll
			would be copied into our output and end up shipped inside our zips, shadowing the
			player's real install.
		-->
		<PackageReference Include="S1API.Forked" Version="3.2.0" ExcludeAssets="runtime" />
	</ItemGroup>
	
	<!--SteamNetworkLib Reference-->
	<ItemGroup Condition="'$(Configuration)' == 'MONO'">
		<Reference Include="SteamNetworkLib">
			<HintPath>Libs\SteamNetworkLib-Mono.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'IL2CPP'">
		<Reference Include="SteamNetworkLib">
			<HintPath>Libs\SteamNetworkLib-Il2Cpp.dll</HintPath>
		</Reference>
	</ItemGroup>
	<!--Publicizer Entries-->
	<ItemGroup Condition="'$(Configuration)' == 'IL2CPP'">
		<Publicize Include="Assembly-CSharp:Il2CppScheduleOne.NPCs.NPC.Start" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'MONO'">
		<Publicize Include="Assembly-CSharp:ScheduleOne.NPCs.NPC.Start" />
	</ItemGroup>

  <!--
    Stage the built DLL into whichever test install this configuration points at.

    This used to be IL2CPP-only, which meant a MONO test run silently exercised whatever DLL the
    PREVIOUS batch left in Schedule I Mono\Mods\ — b22 found that install sitting a whole batch
    behind. Both arms stage now, so "I built it" and "the game is running it" mean the same thing.

    Still gated on Exists('$(S1Dir)\Mods') so a machine without that install just skips it.
    $(S1Dir) is set per configuration by the gitignored Directory.Build.props at the repo root.
  -->
  <Target Name="PostBuild" AfterTargets="Build"
          Condition="Exists('$(S1Dir)\Mods')">
    <Message Text="[$(Configuration)] Staging $(TargetFileName) -> $(S1Dir)\Mods\" Importance="high" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(S1Dir)\Mods\" />
  </Target>
  <ItemGroup Condition="'$(Configuration)'=='MONO'">
		<None Remove="Libs\MelonLoader\Il2CppAssemblies\**\*.*" />
	</ItemGroup>

  <!-- Inline task to generate VersionInfo.g.cs -->
  <UsingTask TaskName="GenerateVersionInfoTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <Version  ParameterType="System.String" Required="true" />
    </ParameterGroup>

    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
					var dir = Path.GetDirectoryName(FilePath);
					if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir))
							Directory.CreateDirectory(dir);

					var content =
					@"// <auto-generated/> Do not edit. Source: Version.props
					namespace Time_Never_Stops;
					internal static class BuildVersion
					{
							internal const string Value = """ + Version + @""";
					}";	
								File.WriteAllText(FilePath, content);
				]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateVersionInfo" BeforeTargets="BeforeCompile">
    <GenerateVersionInfoTask FilePath="$(IntermediateOutputPath)VersionInfo.g.cs"
                             Version="$(Version)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)VersionInfo.g.cs" AutoGen="True" />
    </ItemGroup>
  </Target>
</Project>